uint _czm_width;
uint _czm_height;
uint _czm_pixelX;
uint _czm_pixelY;
bool _czm_knownXY = false;
uint _czm_featureIndex = round(FeatureID);
Synchro4D_RGBA_DATA.GetDimensions(_czm_width, _czm_height);
_czm_pixelY = _czm_featureIndex / _czm_width;
// Second clause added for robustness, in case one wants to test manually with dummy textures,
// BUT ALSO to handle error cases where FeatureID is invalid in the Cesium tile
bool bHas4DColor = false;
bool bHas4DOpacity = false;
// Graph tests 0.005, but using 0.0051 here to avoid possible float precision issues.
// Must remain consistent with values in ElementTimelineEx::SetVisibilityAt
static const float OriginalAlphaThreshold = 0.0051f;
// Selection_RGBA_DATA is an 8-bit texture; byte 2 is the unselected hover marker written by ITwinSceneTile.
static const uint HoverMarkerAlphaByte = 2u;
if (_czm_width == 1 || _czm_pixelY >= _czm_height)
{
	Combined_RGBA = float4(0, 0, 0, 0.0049f);
}
else
{
	_czm_knownXY = true;
	_czm_pixelX = _czm_featureIndex % _czm_width;
	Combined_RGBA = Synchro4D_RGBA_DATA.Load(int3(_czm_pixelX, _czm_pixelY, 0));
	bHas4DColor = ((Combined_RGBA.x + Combined_RGBA.y + Combined_RGBA.z) != 0);
	if (Combined_RGBA.w > 0 && Combined_RGBA.w < OriginalAlphaThreshold)
		Combined_RGBA.w = 0.0049f;//OriginalAlphaThreshold; // must be < 0.005 despite float precision issues
	else
		bHas4DOpacity = (Combined_RGBA.w < 0.98f);
}
Synchro4D_CutPlanes_DATA.GetDimensions(_czm_width, _czm_height);
if (_czm_width != 1 && !_czm_knownXY)
{
	_czm_pixelX = _czm_featureIndex % _czm_width;
	_czm_pixelY = _czm_featureIndex / _czm_width;
}

// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // //
//                                 !!! IMPORTANT !!!
// This file is #included by the Custom node "Get Synchro4D and selection Values per Feature" of
// MLB_ITwinBlend. When you edit this file, open that node in the Material Editor and increment the
// dummy version number in its Code field, then Apply and Save the asset (git lfs lock it first),
// otherwise Unreal may reuse a precompiled shader cache...
// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // //


// Last two clauses added for robustness, in case one wants to test manually with dummy textures
// (even _czm_pixelX might be >= _czm_width if for some reason the CutPlane texture does not have
//  the same size as the RGBA one)
// BUT ALSO to handle error cases where FeatureID is invalid in the Cesium tile
if (_czm_width == 1 || _czm_pixelX >= _czm_width || _czm_pixelY >= _czm_height)
{
	Synchro4D_CutPlane = float4(0, 0, 0, 0);
}
else
{
	Synchro4D_CutPlane = Synchro4D_CutPlanes_DATA.Load(int3(_czm_pixelX, _czm_pixelY, 0));
}

// Now handle the Selection_RGBA_DATA input (aka "SelectingAndHiding" in the C++ code):
// Synchro4D color and partial or zero opacity have priority, unless Selection_RGBA_DATA's
// opacity is set to zero (Element is hidden)
Selection_RGBA_DATA.GetDimensions(_czm_width, _czm_height);
bool bHasSelHideTex = (_czm_width != 1);
if (bHasSelHideTex && !_czm_knownXY)
{
	_czm_knownXY = true;
	_czm_pixelX = _czm_featureIndex % _czm_width;
	_czm_pixelY = _czm_featureIndex / _czm_width;
}
// 0 = use only BaseColor (no 4D nor Selection highlight), 1 = use none of the BaseColor
// intermediate values used to blink between Selection/BaseColor when not done below between Selection/4D
float BaseColorBlendRatio = 0.f;
HoverMask = 0.f;
if (bHasSelHideTex && _czm_pixelY < _czm_height)
{
	float4 SelecHideRGBA = Selection_RGBA_DATA.Load(int3(_czm_pixelX, _czm_pixelY, 0));
	bool bSelected = (SelecHideRGBA.x + SelecHideRGBA.y + SelecHideRGBA.z) != 0;
	uint SelectionAlphaByte = (uint)round(SelecHideRGBA.w * 255.f);
	HoverMask = (!bSelected && !bHas4DColor && SelectionAlphaByte == HoverMarkerAlphaByte) ? 1.f : 0.f;
	// Alpha strictly between 0 and 1 means "selected, no blinking": it is then the (constant) mix ratio
	// between the base and selection colors (see SELECTION_SOLID_ALPHA in ITwinSceneTile.cpp),
	// instead of the time-based BlinkingFactor
	float SelectionFactor = (SelecHideRGBA.w > 0.f && SelecHideRGBA.w < 0.99f) ? SelecHideRGBA.w : BlinkingFactor;
	if (bHas4DColor)
	{
		// Use none of the base color: set to 1. and not BlinkingFactor even when selected,
		// as it is used directly below to mix 4D and selection colors
		BaseColorBlendRatio = 1.f;
		// When selected, blink between Selection and 4D colors:
		if (bSelected)
		{
			Combined_RGBA.xyz = (1.f - SelectionFactor) * Combined_RGBA.xyz;
			Combined_RGBA.xyz += SelectionFactor * SelecHideRGBA.xyz;
		}
	}
	else
	{
		Combined_RGBA.xyz = SelecHideRGBA.xyz;
		// When selected, we need to set the output to the BlinkingFactor so that the base color
		// can be interpolated with the selection color: this is done outside this GLSL node
		// (see Lerp node higher up in the Blueprint).
		// Note: this will blink only RGB, not alpha, as the material may be opaque.
		if (bSelected)
			BaseColorBlendRatio = SelectionFactor;
	}
	// Selection_RGBA_DATA's alpha: zero means hidden; nonzero also encodes hover and selection blending,
	// not opacity to blend or multiply into Combined_RGBA.
	if (SelecHideRGBA.w == 0)
	{
		Combined_RGBA.w = 0;
		BaseColorBlendRatio = 0;
	}
	// Make selected Elements less transparent, for clarity:
	// (Note: bHas4DOpacity and Combined_RGBA.w == 0.0049 (special "original alpha" value) are mutually exclusive)
	else if (bSelected && bHas4DOpacity && Combined_RGBA.w != 0 && !MATERIALBLENDING_ANY_TRANSLUCENT)
	{
		Combined_RGBA.w += (1.f - Combined_RGBA.w) / 2.f;
	}
}
else if (bHas4DColor)
{
	BaseColorBlendRatio = 1.f; // Use none of the base color
}
return BaseColorBlendRatio;